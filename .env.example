# Production Environment Variables Template
# Copy this file to .env and fill in your actual values

# ─── Docker Hub ───────────────────────────────────────────────
DOCKER_LOGIN=your_dockerhub_username

# ─── Database ─────────────────────────────────────────────────
POSTGRES_USER=learning_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=learning_assistant

# ─── JWT ──────────────────────────────────────────────────────
JWT_SECRET_KEY=your_super_secret_jwt_key_here_min_32_chars

# ─── AI APIs (at least one required) ──────────────────────────
OPENAI_API_KEY=sk-your-openai-key-here
GOOGLE_API_KEY=your-google-api-key-here

# ─── Frontend ─────────────────────────────────────────────────
# NEXT_PUBLIC_API_URL: Used by Next.js server to proxy /api/* requests
# - Local Docker: http://backend:8001
# - Railway: https://<backend-service>.up.railway.app
NEXT_PUBLIC_API_URL=http://localhost:8001

# ─── CORS ─────────────────────────────────────────────────────
# Railway: ["https://<frontend-service>.railway.app"]
CORS_ORIGINS=["http://localhost:3000"]

# ─── Railway (CircleCI only) ──────────────────────────────────
RAILWAY_TOKEN=your_railway_token_here
